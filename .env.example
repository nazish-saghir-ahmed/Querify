# =============================================================================
# Querify Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8)
# -----------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/querify_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# -----------------------------------------------------------------------------
# AI Engine Configuration
# Modes:
#   "demo" - Works 100% offline with zero API key requirement (default & fail-safe)
#   "live" - Connects to Google Gemini API or compatible provider
# -----------------------------------------------------------------------------
AI_MODE=demo
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Query Engine Constraints
# -----------------------------------------------------------------------------
QUERIFY_MAX_LIMIT=100
QUERIFY_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
